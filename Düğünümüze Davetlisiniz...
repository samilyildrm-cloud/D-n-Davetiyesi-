<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aryan & Erkam - Düğün Davetiyesi</title>
  
  <!-- WhatsApp ve Sosyal Medya Önizleme Ayarları (Open Graph) -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Aryan & Erkam Düğün Davetiyesi 💍">
  <meta property="og:description" content="31 Ağustos 2026 Pazartesi - Düğünümüze davetlisiniz!">
  <meta property="og:image" content="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=600&auto=format&fit=crop">
  <meta property="og:image:width" content="600">
  <meta property="og:image:height" content="315">

  <!-- Fontlar -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: linear-gradient(135deg, #faf6f0 0%, #eef2f5 100%);
      font-family: 'Montserrat', sans-serif;
      color: #2c2c2c;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px 10px;
      overflow-x: hidden;
    }

    .card {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.08);
      max-width: 520px;
      width: 100%;
      padding: 35px 25px;
      text-align: center;
      border: 1px solid #e0d5c1;
      position: relative;
    }

    .border-frame {
      border: 2px solid #d4af37;
      border-radius: 15px;
      padding: 25px 15px;
      position: relative;
    }

    .title-sub {
      font-family: 'Cinzel', serif;
      letter-spacing: 3px;
      font-size: 0.85rem;
      color: #8b7355;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .couples-names {
      font-family: 'Great Vibes', cursive;
      font-size: 3.2rem;
      color: #1a1a1a;
      margin: 10px 0;
      line-height: 1.2;
    }

    .and-symbol {
      font-size: 1.8rem;
      font-family: 'Cinzel', serif;
      color: #d4af37;
      display: block;
      margin: -5px 0;
    }

    .verse-box {
      font-style: italic;
      font-size: 0.85rem;
      color: #555;
      margin: 15px 0 25px 0;
      line-height: 1.6;
      background: #faf7f2;
      padding: 12px;
      border-radius: 8px;
      border-left: 3px solid #d4af37;
    }

    /* Araba Animasyon Alanı */
    .animation-card {
      background: #fdfbf7;
      border: 1px solid #ebdcb9;
      border-radius: 12px;
      padding: 15px 10px;
      margin: 20px 0;
    }

    .anim-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: #8b7355;
      margin-bottom: 10px;
    }

    .animation-container {
      position: relative;
      width: 100%;
      height: 60px;
      background: #f2ece1;
      border-radius: 30px;
      border: 1px dashed #d4af37;
      margin: 10px 0;
      overflow: hidden;
    }

    .road-line {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 2px;
      background: repeating-linear-gradient(90deg, #d4af37, #d4af37 10px, transparent 10px, transparent 20px);
      transform: translateY(-50%);
    }

    .wedding-car {
      position: absolute;
      left: 5px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.8rem;
      transition: left 3.5s cubic-bezier(0.25, 1, 0.5, 1);
      cursor: pointer;
      z-index: 2;
    }

    .heart-destination {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.6rem;
      z-index: 1;
    }

    .btn-animate {
      background: linear-gradient(135deg, #d4af37 0%, #b89028 100%);
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
      transition: transform 0.2s, background 0.2s;
    }

    .btn-animate:hover {
      transform: scale(1.03);
    }

    /* Etkinlik Kartları */
    .event-card {
      border: 1px solid #e5e5e5;
      background-color: #fafafa;
      padding: 18px 15px;
      border-radius: 10px;
      margin-top: 20px;
      text-align: center;
    }

    .event-title {
      font-family: 'Great Vibes', cursive;
      font-size: 2.3rem;
      color: #1a1a1a;
    }

    .event-date {
      font-weight: 600;
      font-size: 1.05rem;
      color: #333;
      margin: 5px 0;
    }

    .event-location {
      font-size: 0.85rem;
      color: #555;
      line-height: 1.4;
      margin-bottom: 12px;
    }

    .btn-map {
      display: inline-block;
      padding: 8px 16px;
      background-color: #2c2c2c;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 500;
      transition: background 0.3s ease;
    }

    .btn-map:hover {
      background-color: #d4af37;
    }

    /* Aileler */
    .families {
      display: flex;
      justify-content: space-around;
      margin: 25px 0 10px 0;
      padding-top: 15px;
      border-top: 1px solid #eee;
    }

    .family h3 {
      font-family: 'Great Vibes', cursive;
      font-size: 1.7rem;
      color: #8b7355;
    }

    .family p {
      font-size: 0.85rem;
      margin-top: 3px;
    }

    .family strong {
      display: block;
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .footer-note {
      font-size: 0.75rem;
      color: #888;
      margin-top: 15px;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="border-frame">
      <div class="title-sub">Davetlisiniz</div>
      
      <div class="couples-names">
        Aryan Yıldız
        <span class="and-symbol">&</span>
        Erkam Yıldırım
      </div>

      <div class="verse-box">
        “İçinizden kendileriyle huzura kavuşacağınız eşler yaratıp, aranızda muhabbet ve rahmet var etmesi, O'nun varlığının delillerindendir.”
        <br><strong>(Rum 21)</strong>
      </div>

      <!-- ARABA ANİMASYONU -->
      <div class="animation-card">
        <div class="anim-title">Düğünümüze Doğru Yola Çıkın!</div>
        <button class="btn-animate" onclick="driveCar()">🚗 Gelin Arabasını Sür</button>
        
        <div class="animation-container">
          <div class="road-line"></div>
          <div class="wedding-car" id="car" onclick="driveCar()">🚗💨👰‍♀️🤵‍♂️</div>
          <div class="heart-destination" id="heart">💒</div>
        </div>
      </div>

      <!-- KINA GECESİ -->
      <div class="event-card">
        <div class="event-title">Kına Gecesi</div>
        <div class="event-date">28 Ağustos 2026 Cuma — Saat 19:00</div>
        <div class="event-location">
          Bağlarçeşme Mah. 19 Mayıs Bulvarı No:20/C<br>
          Taşçı Plaza - Esenyurt / İSTANBUL
        </div>
        <a href="https://maps.google.com/?q=Bağlarçeşme+Mah.+19+Mayıs+Bulvarı+No:20/C+Esenyurt+İstanbul" target="_blank" class="btn-map">📍 Yol Tarifi Al</a>
      </div>

      <!-- DÜĞÜN -->
      <div class="event-card">
        <div class="event-title">Düğün & Nikâh</div>
        <div class="event-date">31 Ağustos 2026 Pazartesi — Saat 18:00</div>
        <div class="event-location">
          Beyazsaray Düğün Salonu (Baraj Yolu Üzeri)<br>
          Kahta / ADIYAMAN
        </div>
        <a href="https://maps.google.com/?q=Beyazsaray+Düğün+Salonu+Kahta+Adıyaman" target="_blank" class="btn-map">📍 Yol Tarifi Al</a>
      </div>

      <!-- AİLELER -->
      <div class="families">
        <div class="family">
          <h3>Yıldız Ailesi</h3>
          <p>Kevser & Refik</p>
          <strong>YILDIZ</strong>
        </div>
        <div class="family">
          <h3>Yıldırım Ailesi</h3>
          <p>Emine & Mithat</p>
          <strong>YILDIRIM</strong>
        </div>
      </div>

      <div class="footer-note">Bu mutlu günümüzde sizleri de aramızda görmekten onur duyarız.</div>

    </div>
  </div>

  <script>
    function driveCar() {
      const car = document.getElementById('car');
      const heart = document.getElementById('heart');
      
      car.style.left = 'calc(100% - 75px)';
      
      setTimeout(() => {
        heart.innerHTML = '💒💖🎉';
      }, 3500);
    }
  </script>
</body>
</html>
